{
  "name": "swiss-dev",
  "version": "0.1.9",
  "description": "Swiss Dev desktop AI development workspace",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron electron/main.cjs\"",
    "electron:build": "npm run build && node electron/prepare-standalone.cjs && electron-builder",
    "tauri": "tauri",
    "tauri:dev": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri dev",
    "tauri:build": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.19.10",
    "@google/generative-ai": "^0.21.0",
    "@heroicons/react": "^1.0.6",
    "@mui/material": "^6.4.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "^2.11.1",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.18.2",
    "dedent": "^1.5.3",
    "jszip": "^3.10.1",
    "jzip": "^1.0.0",
    "lucide-react": "^0.471.2",
    "next": "15.1.11",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.4",
    "openai": "^4.104.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^9.0.3",
    "tailwind-merge": "^2.6.0",
    "tailwind-scrollbar-hide": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.23.0": true,
    "sharp@0.33.5": true
  },
  "build": {
    "appId": "com.swissdev.desktop",
    "productName": "Swiss Dev",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Swiss-Dev-Setup.exe"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Swiss-Dev.dmg"
    }
  }
}
